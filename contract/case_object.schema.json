{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://e-rakshak.local/schemas/case_object.schema.json",
  "title": "E-Rakshak Unified Case Object",
  "description": "The complete response of GET /api/v1/cases/{case_id}. This is THE UI contract: the frontend reads this and nothing else. Assembled by the aggregation endpoint from the spine tables; identical in shape for Windows and Android — only platform_details differs. No UI component may read a module's native output directly.",
  "type": "object",
  "required": ["schema_version", "case_id", "header", "summary", "capabilities", "findings", "iocs", "provenance", "caveats", "artifacts", "integrity"],
  "additionalProperties": false,

  "$defs": {
    "tier": {
      "description": "Canonical scale. FIVE values, not four: 'allowlisted' is already emitted by the C2/Exfil module for findings detected but judged benign (surfaced, never asserted) and ranks below 'unconfirmed'.",
      "enum": ["confirmed", "strong", "weak", "unconfirmed", "allowlisted"]
    }
  },

  "properties": {
    "schema_version": { "const": "2.0" },
    "case_id": { "type": "string", "format": "uuid" },

    "header": {
      "type": "object",
      "description": "Case identity. Rendered at the top of every screen, identical for both platforms.",
      "required": ["sample_sha256", "platform", "status", "submitted_at"],
      "additionalProperties": false,
      "properties": {
        "sample_sha256": { "type": "string", "pattern": "^[a-fA-F0-9]{64}$" },
        "sample_md5": { "type": ["string", "null"] },
        "sample_sha1": { "type": ["string", "null"] },
        "original_filename": { "type": ["string", "null"] },
        "file_size_bytes": { "type": ["integer", "null"] },
        "file_type": { "type": ["string", "null"] },
        "platform": { "enum": ["windows", "android"] },
        "status": { "enum": ["queued", "running", "completed", "partial", "failed", "unsupported"] },
        "status_reason": { "type": ["string", "null"] },
        "profile": { "type": ["string", "null"] },
        "submitted_at": { "type": "string", "format": "date-time" },
        "started_at": { "type": ["string", "null"], "format": "date-time" },
        "completed_at": { "type": ["string", "null"], "format": "date-time" },
        "native_session_id": { "type": ["string", "null"] },
        "native_task_id": { "type": ["integer", "null"] }
      }
    },

    "summary": {
      "type": "object",
      "description": "LAYER 1 — the officer's screen. Everything here must be readable by someone with no security training. If a field cannot be filled without jargon, leave it null rather than degrading it.",
      "required": ["verdict", "headline"],
      "additionalProperties": false,
      "properties": {
        "verdict": { "oneOf": [{ "$ref": "#/$defs/tier" }, { "type": "null" }] },
        "verdict_label": {
          "type": ["string", "null"],
          "description": "Officer-facing rendering of the tier, e.g. 'Confirmed malicious', 'Likely malicious', 'Suspicious — unconfirmed', 'No malicious behaviour observed'."
        },
        "headline": {
          "type": "string",
          "description": "One sentence answering both questions the officer has. e.g. 'This app recorded incoming SMS messages including one-time passwords and sent them to a server in Singapore.'"
        },
        "what_was_taken": {
          "type": "array",
          "description": "Deduplicated plain-language list derived from capabilities + provenance + findings.data_type_accessed.",
          "items": { "type": "string" }
        },
        "where_it_went": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["destination", "confidence_tier"],
            "additionalProperties": false,
            "properties": {
              "destination": { "type": "string" },
              "destination_domain": { "type": ["string", "null"] },
              "geo_country": { "type": ["string", "null"] },
              "asn_org": { "type": ["string", "null"] },
              "reputation_note": { "type": ["string", "null"] },
              "confidence_tier": { "$ref": "#/$defs/tier" }
            }
          }
        },
        "counts": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "capabilities": { "type": "integer", "minimum": 0 },
            "findings": { "type": "integer", "minimum": 0 },
            "destinations": { "type": "integer", "minimum": 0 },
            "iocs": { "type": "integer", "minimum": 0 },
            "caveats": { "type": "integer", "minimum": 0 }
          }
        }
      }
    },

    "capabilities": {
      "type": "array",
      "description": "What the malware can do. Windows sources: CAPE signatures, YARA, static_hypotheses, correlation. NOTE: capa reports tool_failure on the task-18 bundle — do not assume it is available. Android sources: MobSF permissions, API monitor, Frida.",
      "items": {
        "type": "object",
        "required": ["capability", "plain_language", "confidence_tier", "source"],
        "additionalProperties": false,
        "properties": {
          "capability": {
            "enum": [
              "credential_theft", "keylogging", "screen_capture", "clipboard_theft",
              "file_exfiltration", "crypto_wallet_theft", "sms_interception",
              "contact_exfiltration", "call_log_access", "location_tracking",
              "audio_recording", "camera_access", "remote_command_execution",
              "persistence", "process_injection", "anti_analysis",
              "overlay_attack", "accessibility_abuse", "device_admin_abuse"
            ]
          },
          "plain_language": { "type": "string" },
          "mitre_technique_id": { "type": ["string", "null"] },
          "mitre_technique_name": { "type": ["string", "null"] },
          "confidence_tier": { "$ref": "#/$defs/tier" },
          "source": {
            "enum": ["capa", "cape_signature", "yara", "correlation", "static_hypothesis",
                     "mobsf_permission", "mobsf_api_monitor", "frida", "static_analysis"]
          },
          "evidence_refs": { "type": "array", "items": { "type": "object" } }
        }
      }
    },

    "findings": {
      "type": "array",
      "description": "LAYER 2 — exfil_events rows. Identical shape for both platforms, because both are produced by the same detection pipeline wherever a PCAP exists.",
      "items": {
        "type": "object",
        "required": ["event_id", "confidence_tier"],
        "additionalProperties": false,
        "properties": {
          "event_id": { "type": "string" },
          "timestamp": { "type": ["string", "null"], "format": "date-time" },
          "finding_kind": { "enum": ["beacon", "exfil", "correlation", "reputation", "covert_channel", "dns", "static_ioc", "unclassified", null] },
          "plain_language": { "type": ["string", "null"] },

          "data_type_accessed": { "type": ["string", "null"] },
          "access_api_call": { "type": ["string", "null"] },

          "destination_ip": { "type": ["string", "null"] },
          "destination_port": { "type": ["integer", "null"] },
          "destination_domain": { "type": ["string", "null"] },

          "asn": { "type": ["string", "null"] },
          "asn_org": { "type": ["string", "null"] },
          "geo_country": { "type": ["string", "null"] },
          "reputation_score": { "type": ["number", "null"] },
          "reputation_note": { "type": ["string", "null"] },
          "reputation_source": { "type": ["string", "null"] },

          "ja3_hash": { "type": ["string", "null"] },
          "ja4_hash": { "type": ["string", "null"] },
          "plaintext_available": { "type": ["boolean", "null"] },

          "confidence_score": { "type": ["number", "null"] },
          "confidence_tier": { "$ref": "#/$defs/tier" },
          "mitre_technique_id": { "type": ["string", "null"] },

          "capped_by_caveat": {
            "type": ["string", "null"],
            "description": "Caveat code that limited this finding's tier. When set, the UI shows the tier alongside the reason it could not go higher."
          },
          "evidence_refs": { "type": "array", "items": { "type": "object" } },
          "manifest_sha256": { "type": ["string", "null"] },
          "evidence_hash": { "type": ["string", "null"] }
        }
      }
    },

    "provenance": {
      "type": "array",
      "description": "Item-level provenance — which stolen item left, via what channel, to where, when, and the SHA-256 of the recovered bytes. This is the C2/Exfil module's headline capability (MEETING_BRIEF.md) and the strongest evidentiary artefact the tool produces. Android may return an empty array.",
      "items": {
        "type": "object",
        "required": ["item_type", "destination", "confidence_tier"],
        "additionalProperties": false,
        "properties": {
          "item_type": { "type": "string" },
          "access_api_call": { "type": ["string", "null"] },
          "channel": { "type": ["string", "null"] },
          "destination": { "type": "string" },
          "time_delta_s": { "type": ["number", "null"] },
          "recovered_bytes": { "type": ["integer", "null"] },
          "recovered_sha256": { "type": ["string", "null"] },
          "confidence_tier": { "$ref": "#/$defs/tier" },
          "plain_language": {
            "type": ["string", "null"],
            "description": "e.g. 'Saved browser passwords were read and sent to 188.190.10.10 over FTP 4 seconds later (2118 bytes recovered).'"
          },
          "linked_event_id": { "type": ["string", "null"] }
        }
      }
    },

    "iocs": {
      "type": "array",
      "description": "Exportable indicators. Drives CSV and STIX 2.1 export.",
      "items": {
        "type": "object",
        "required": ["ioc_type", "value", "source"],
        "additionalProperties": false,
        "properties": {
          "ioc_type": { "enum": ["domain", "ip", "url", "port", "hash", "email"] },
          "value": { "type": "string" },
          "source": {
            "type": "string",
            "description": "Vocabulary fixed by unified_solution_overview.md section 4: 'family_decryptor' | 'mobsf_manifest' | 'yara'."
          },
          "confidence_weight": { "type": ["number", "null"] },
          "seen_in_traffic": {
            "type": "boolean",
            "description": "True when a statically-extracted indicator was also observed on the wire — the strongest single corroboration signal available."
          },
          "first_seen_at": { "type": ["string", "null"], "format": "date-time" }
        }
      }
    },

    "timeline": {
      "type": "array",
      "description": "Unified host+network kill-chain. Shape matches what pipeline/timeline.py already emits (output/timeline.json) — do not invent a parallel one.",
      "items": {
        "type": "object",
        "required": ["timestamp", "actor", "description"],
        "additionalProperties": false,
        "properties": {
          "timestamp": { "type": "string", "format": "date-time" },
          "actor": { "enum": ["host", "network", "static"] },
          "phase": {
            "type": ["string", "null"],
            "description": "Kill-chain phase, e.g. 'collection', 'command-and-control', 'exfiltration'."
          },
          "mitre": { "type": ["string", "null"] },
          "description": { "type": "string" },
          "tier": { "oneOf": [{ "$ref": "#/$defs/tier" }, { "type": "null" }] },
          "linked_event_id": { "type": ["string", "null"] }
        }
      }
    },

    "caveats": {
      "type": "array",
      "description": "The honesty layer. MUST be rendered prominently, not hidden behind a tab. Never emit an empty array by default — an empty array asserts the analysis was unqualified.",
      "items": {
        "type": "object",
        "required": ["code", "severity", "plain_language"],
        "additionalProperties": false,
        "properties": {
          "code": { "type": "string" },
          "severity": { "enum": ["info", "warning", "critical"] },
          "plain_language": { "type": "string" },
          "affects_data_types": { "type": "array", "items": { "type": "string" } },
          "affects_finding_kinds": { "type": "array", "items": { "type": "string" } },
          "detail": { "type": "object" }
        }
      }
    },

    "platform_details": {
      "type": "object",
      "description": "The ONLY platform-divergent section. The UI dispatches on header.platform and renders the matching component into a fixed slot.",
      "additionalProperties": true,
      "properties": {
        "windows": {
          "type": "object",
          "additionalProperties": true,
          "properties": {
            "pe": { "type": "object" },
            "yara_hits": { "type": "array", "items": { "type": "string" } },
            "clamav": { "type": ["object", "null"] },
            "vt_lookup": { "type": ["string", "null"] },
            "static_risk_score": { "type": ["number", "null"] },
            "static_hypotheses": { "type": "array", "items": { "type": "string" } },
            "process_tree": { "type": ["array", "null"] },
            "registry_persistence": { "type": ["array", "null"] },
            "suricata_alerts": {
              "type": ["array", "null"],
              "description": "From analysis/suricata.json in the ST/DT bundle. Suricata is owned by ST/DT — do not run a second instance."
            },
            "telemetry": { "type": "object" },
            "access_events_source": { "type": ["string", "null"] },
            "guest_image_version": { "type": ["string", "null"] },
            "network_mode": { "enum": ["simulated_inetsim", "live_egress", null] }
          }
        },
        "android": {
          "type": "object",
          "additionalProperties": true,
          "properties": {
            "package_name": { "type": ["string", "null"] },
            "version_name": { "type": ["string", "null"] },
            "permissions": {
              "type": "array",
              "items": {
                "type": "object",
                "additionalProperties": true,
                "properties": {
                  "name": { "type": "string" },
                  "status": { "type": ["string", "null"] },
                  "description": { "type": ["string", "null"] },
                  "exercised_at_runtime": { "type": ["boolean", "null"] }
                }
              }
            },
            "certificate": { "type": ["object", "null"] },
            "trackers": { "type": "array", "items": { "type": "object" } },
            "mobsf_security_score": { "type": ["number", "null"] },
            "apkid": { "type": ["object", "null"] },
            "device_backend": { "enum": ["redroid", "avd", null] },
            "tls_intercepted": { "type": ["boolean", "null"] }
          }
        }
      }
    },

    "integrity": {
      "type": "object",
      "description": "Chain of custody. Windows links its row chain to the ST/DT bundle manifest hash via exfil_events.manifest_sha256; Android must produce an equivalent chain (see docs/android_schema_parity.md).",
      "required": ["chain_verified"],
      "additionalProperties": false,
      "properties": {
        "chain_verified": { "type": "boolean" },
        "chain_length": { "type": ["integer", "null"] },
        "root_hash": { "type": ["string", "null"] },
        "bundle_manifest_sha256": { "type": ["string", "null"] },
        "case_manifest_id": {
          "type": ["string", "null"],
          "description": "Deterministic case id from output/case_manifest.json — same evidence in, same id out."
        },
        "verified_at": { "type": ["string", "null"], "format": "date-time" }
      }
    },

    "artifacts": {
      "type": "array",
      "description": "LAYER 3. Downloads resolve by artifact_id server-side; storage paths are never exposed. Filter by access_tier before rendering in the officer view.",
      "items": {
        "type": "object",
        "required": ["artifact_id", "kind", "label", "access_tier"],
        "additionalProperties": false,
        "properties": {
          "artifact_id": { "type": "string", "format": "uuid" },
          "kind": { "type": "string" },
          "label": { "type": "string" },
          "download_url": { "type": ["string", "null"] },
          "external_url": { "type": ["string", "null"] },
          "sha256": { "type": ["string", "null"] },
          "size_bytes": { "type": ["integer", "null"] },
          "access_tier": { "enum": ["officer", "analyst"] }
        }
      }
    },

    "tool_versions": {
      "type": "object",
      "description": "Forensic provenance — which tool versions produced this case. Display on the case page.",
      "additionalProperties": true
    }
  }
}
