{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "$id":"https://umat.local/contracts/c2/c2-event-v1.3.schema.json",
  "title":"C2/Exfil event schema 1.3 — UMAT integration profile",
  "$comment":"Derived from sql/schema.sql at C2 commit bc5bb681495a02fa0ff2411087e5a00ece5b1ca3. case_id must equal the UMAT analysis_run_id. Integration fields are required even though upstream SQL keeps them nullable for standalone compatibility.",
  "type":"object",
  "required":["event_id","sample_id","platform","timestamp","confidence_tier","evidence_hash","case_id","finding_kind","plain_language","evidence_refs"],
  "additionalProperties":false,
  "properties":{
    "event_id":{"type":"string","format":"uuid"},
    "sample_id":{"type":"string","pattern":"^[a-f0-9]{64}$"},
    "session_id":{"type":["string","null"]},
    "cape_task_id":{"type":["integer","null"]},
    "platform":{"enum":["windows","android"]},
    "timestamp":{"type":"string","format":"date-time"},
    "data_type_accessed":{"type":["string","null"]},
    "access_api_call":{"type":["string","null"]},
    "destination_ip":{"type":["string","null"]},
    "destination_port":{"type":["integer","null"],"minimum":0,"maximum":65535},
    "destination_domain":{"type":["string","null"]},
    "asn":{"type":["string","null"]},
    "asn_org":{"type":["string","null"]},
    "geo_country":{"type":["string","null"]},
    "reputation_score":{"type":["number","null"]},
    "reputation_note":{"type":["string","null"]},
    "reputation_source":{"type":["string","null"]},
    "ja3_hash":{"type":["string","null"]},
    "plaintext_available":{"type":["boolean","null"]},
    "confidence_score":{"type":["number","null"]},
    "confidence_tier":{"enum":["allowlisted","unconfirmed","weak","strong","confirmed"]},
    "mitre_technique_id":{"type":["string","null"]},
    "manifest_sha256":{"type":["string","null"],"pattern":"^[a-f0-9]{64}$"},
    "evidence_hash":{"type":"string","pattern":"^[a-f0-9]{64}$"},
    "case_id":{"type":"string","format":"uuid"},
    "finding_kind":{"enum":["beacon","exfil","correlation","reputation","covert_channel","dns","static_ioc"]},
    "plain_language":{"type":"string","minLength":1},
    "capped_by_caveat":{"type":["string","null"]},
    "evidence_refs":{"type":"array","items":{"type":"object"}}
  }
}
